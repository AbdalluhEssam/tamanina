<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/worship_widget_background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_beads_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/worship_art_beads"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_tasbeeh_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="9dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_tasbeeh_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/worship_widget_gold"
            android:textSize="29sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tasbeeh_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/worship_widget_ink"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_shortcut_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="7dp"
        android:paddingEnd="7dp">

        <ImageView
            android:id="@+id/widget_shortcut_icon"
            android:layout_width="53dp"
            android:layout_height="53dp"
            android:src="@drawable/worship_icon_sunrise"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/widget_shortcut_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/worship_widget_ink"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
